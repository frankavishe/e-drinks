# Supabase → Project Settings → Database → Connection string → "Session pooler" (port 5432).
# Replace the postgresql:// prefix with postgresql+asyncpg://
DATABASE_URL=postgresql+asyncpg://postgres.<project-ref>:<db-password>@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
# Supabase → Project Settings → API
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=
# Supabase → Project Settings → API → JWT Settings → Legacy JWT secret (only needed for HS256 projects)
SUPABASE_JWT_SECRET=
# Resend (phase 3)
RESEND_API_KEY=
EMAIL_FROM=e-drinks <bookings@example.com>
ADMIN_EMAIL=
CORS_ORIGINS=http://localhost:5173
